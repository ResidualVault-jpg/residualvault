# =============================================================
# ResidualVault AI Agent System - Environment Configuration
# Copy this file to .env and fill in your actual values
# =============================================================

# --- AI API Keys ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
HEYGEN_API_KEY=your_heygen_api_key_here

# --- Database ---
# Path to SQLite database file (relative to project root)
DB_PATH=./data/residualvault.db

# --- Dashboard (rv-control) ---
DASHBOARD_PORT=3001
DASHBOARD_HOST=0.0.0.0
DASHBOARD_SECRET=change_this_to_a_strong_secret

# --- Application ---
NODE_ENV=production
LOG_LEVEL=info
RESIDUALVAULT_URL=https://residualvault.com
BRAND_NAME=ResidualVault
BRAND_TAGLINE=Your Passive Income Vault

# --- Email (Email Conductor Agent) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_smtp_password_here
EMAIL_FROM=noreply@residualvault.com
EMAIL_FROM_NAME=ResidualVault

# --- Social Media Tokens (Social Media Agent) ---
TWITTER_BEARER_TOKEN=
FACEBOOK_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
LINKEDIN_ACCESS_TOKEN=

# --- Analytics ---
GOOGLE_ANALYTICS_ID=
MIXPANEL_TOKEN=

# --- HeyGen Settings ---
HEYGEN_AVATAR_ID=default_avatar_id
HEYGEN_VOICE_ID=default_voice_id

# --- Security ---
# Comma-separated list of allowed dashboard IP addresses (leave empty to allow all)
ALLOWED_IPS=
